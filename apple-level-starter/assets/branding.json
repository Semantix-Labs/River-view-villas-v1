  "imagery": {
    "style": "Moody, warm, high-contrast editorial photography",
    "subjects": [
      "Bentota River at dawn/dusk",
      "Aerial/drone of villa and river",
      "Hands-on Ayurvedic treatments — oil pouring, massage",
      "Lush tropical gardens with morning light",
      "Yoga on open-air pavilion",
      "Herbal ingredients — botanicals, oils, powders",
      "Guests in deep relaxation (no forced smiles)",
      "Shirodhara oil stream",
      "Architectural details — villa textures, wood, stone",
      "Ayurvedic meals — earthy ceramic bowls, herbs"
    ],
    "editing": {
      "tone": "Warm — boost amber/gold in midtones",
      "contrast": "Medium-high — rich shadows",
      "saturation": "Slightly desaturated — earthy, not vivid",
      "avoid": ["Bright blue sky hero shots", "Stock photo smiling models", "Sterile white spa aesthetic", "Oversaturated tropical colors"]
    },
    "overlays": {
      "hero": "linear-gradient(to bottom, rgba(26,20,16,0.45) 0%, rgba(26,20,16,0.6) 100%)",
      "card_hover": "rgba(26,20,16,0.2)",
      "text_protection": "linear-gradient(to top, rgba(26,20,16,0.7) 0%, transparent 60%)"
    },
    "aspect_ratios": {
      "hero": "16:9 or full viewport height",
      "package_card": "4:3",
      "villa_card": "1:1 or 3:4 portrait",
      "treatment": "1:1 square",
      "gallery": "Mixed — 1:1, 4:3, 3:4"
    },
    "rules": [
      "Always use Next.js <Image> with priority on above-fold",
      "Lazy load all below-fold images",
      "Minimum resolution: 1400px wide for hero, 800px for cards",
      "Alt text always descriptive for accessibility and SEO"
    ]
  },

  "animation": {
    "library": "Framer Motion",
    "philosophy": "Restraint — one well-orchestrated reveal is worth 10 micro-interactions",
    "presets": {
      "fade_up": {
        "initial": { "opacity": 0, "y": 24 },
        "animate": { "opacity": 1, "y": 0 },
        "transition": { "duration": 0.7, "ease": "easeOut" }
      },
      "fade_in": {
        "initial": { "opacity": 0 },
        "animate": { "opacity": 1 },
        "transition": { "duration": 0.6, "ease": "easeOut" }
      },
      "stagger_children": {
        "variants_container": { "animate": { "transition": { "staggerChildren": 0.12 } } },
        "variants_item": {
          "hidden": { "opacity": 0, "y": 20 },
          "visible": { "opacity": 1, "y": 0, "transition": { "duration": 0.6 } }
        }
      },
      "scale_in": {
        "initial": { "opacity": 0, "scale": 0.96 },
        "animate": { "opacity": 1, "scale": 1 },
        "transition": { "duration": 0.5, "ease": "easeOut" }
      }
    },
    "scroll_trigger": "Use Framer Motion whileInView with once:true",
    "parallax": {
      "hero_image": "Subtle Y offset on scroll — max 60px movement",
      "implementation": "useScroll + useTransform from framer-motion"
    },
    "hover_states": {
      "cards": "translateY(-4px) + shadow deepens — 0.3s ease",
      "buttons": "translateY(-1px) — 0.2s ease",
      "links": "Arrow slides right 4px — 0.2s ease",
      "images": "scale(1.02) inside overflow:hidden — 0.5s ease"
    },
    "page_transitions": {
      "enter": "Fade up — 0.5s",
      "exit": "Fade out — 0.3s"
    },
    "rules": [
      "Never animate more than 3 elements simultaneously",
      "Respect prefers-reduced-motion — wrap all animations in check",
      "No bounce or spring on luxury brand — use easeOut only",
      "No loading spinners — use skeleton screens with cream/gold-light colors",
      "Avoid parallax on mobile — disable for performance"
    ]
  },

  "iconography": {
    "library": "Lucide React",
    "size": {
      "nav": "20px",
      "inline": "18px",
      "feature": "24px",
      "large_accent": "40px"
