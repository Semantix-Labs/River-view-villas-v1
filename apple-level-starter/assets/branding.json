        "padding": "32px",
        "badge": {
          "position": "top-left on image",
          "background": "--gold",
          "color": "--deep",
          "text": "Jost 500 11px uppercase 0.15em letterspaced",
          "padding": "6px 14px",
          "border_radius": "2px"
        },
        "hover": {
          "shadow": "0 8px 48px rgba(26,20,16,0.14)",
          "transform": "translateY(-4px)"
        }
      },
      "villa_card": {
        "layout": "Full-width alternating — image 50% / text 50%",
        "image": "Full-bleed, no border-radius on image side",
        "text_padding": "64px",
        "background": "--cream"
      },
      "treatment_card": {
        "layout": "Grid card",
        "background": "--white",
        "padding": "28px",
        "border_top": "2px solid --gold",
        "border_radius": "0 0 4px 4px"
      },
      "review_card": {
        "background": "transparent",
        "border_left": "2px solid --gold",
        "padding_left": "24px",
        "quote_style": "Cormorant Garamond 400 italic 20px"
      }
    },
    "navigation": {
      "desktop": {
        "background": "transparent (scrolled: rgba(26,20,16,0.95) with backdrop-blur)",
        "height": "80px",
        "logo_height": "48px",
        "link_style": "Jost 400 13px uppercase 0.12em letterspaced --white",
        "link_hover": "--gold",
        "active": "--gold",
        "cta_button": "Primary button (gold) — Book Now",
        "position": "fixed top-0 full-width z-50"
      },
      "mobile": {
        "trigger": "Hamburger — 3 lines, gold color",
        "overlay": "Full screen, background --deep",
        "link_style": "Cormorant Garamond 600 32px --white, centered",
        "animation": "Stagger fade-in from bottom"
      }
    },
    "dividers": {
      "gold_rule": {
        "element": "<hr>",
        "border": "none",
        "height": "1px",
        "background": "--gold",
        "opacity": 0.3,
        "width": "80px",
        "usage": "Below eyebrow text, section breaks"
      },
      "section_break": {
        "type": "Full-width 1px line",
        "color": "rgba(201,169,110,0.15)"
      }
    },
    "badges": {
      "most_popular": {
        "background": "--gold",
        "color": "--deep",
        "text": "Most Popular",
        "border_radius": "2px"
      },
      "premium": {
        "background": "--deep",
        "color": "--gold",
        "border": "1px solid --gold",
