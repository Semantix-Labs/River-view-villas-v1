{
  "brand": {
    "name": "River View Villas",
    "tagline": "Where Ancient Healing Meets Sacred Stillness",
    "descriptor": "Luxury Ayurvedic Wellness Retreat · Bentota, Sri Lanka",
    "founded": 2005,
    "aesthetic": "Sacred Luxury — ultra-refined, minimal, conversion-first",
    "personality": [
      "Ancient yet refined",
      "Authoritative yet warm",
      "Healing-focused, never clinical",
      "Premium without ostentation",
      "Serene and purposeful"
    ],
    "voice": {
      "tone": "Poetic, calm, confident, deeply human",
      "avoid": [
        "Generic spa language",
        "Overly technical medical jargon",
        "Exclamation marks",
        "Pushy sales language",
        "Casual slang or contractions"
      ],
      "examples": {
        "good": [
          "Your healing cannot wait any longer.",
          "Five thousand years of wisdom. Applied today.",
          "We do not offer spa days. We offer transformation.",
          "Healing is not a luxury. It is a necessity."
        ],
        "bad": [
          "Book now and get amazing deals!",
          "We offer the best Ayurvedic treatments!",
          "Check out our awesome packages!",
          "You'll love it here!"
        ]
      }
    }
  },

  "colors": {
    "description": "Warm earth palette — gold, cream, deep brown. Never cold, never clinical.",
    "primary": {
      "gold": {
        "hex": "#C9A96E",
        "variable": "--gold",
        "usage": "Primary accent — CTAs, borders, highlights, icon fills, hover states"
      },
      "gold_light": {
        "hex": "#E8D5B0",
        "variable": "--gold-light",
        "usage": "Champagne — hover tints, soft dividers, background accents"
      }
    },
    "dark_surfaces": {
      "deep": {
        "hex": "#1A1410",
        "variable": "--deep",
        "usage": "Near-black warm brown — hero overlays, dark sections, primary dark bg"
      },
      "earth": {
        "hex": "#2C2016",
        "variable": "--earth",
        "usage": "Rich earth brown — full-bleed CTA sections, footer background"
      }
    },
    "backgrounds": {
      "cream": {
        "hex": "#F7F3EE",
        "variable": "--cream",
        "usage": "Warm off-white — default page background, section fills"
      },
      "white": {
        "hex": "#FFFFFF",
        "variable": "--white",
        "usage": "Pure white — cards, modals, form inputs"
      }
    },
    "nature_accents": {
      "sage": {
        "hex": "#7A8C6E",
        "variable": "--sage",
        "usage": "Muted sage green — nature tags, wellness icons, subtle accents"
      },
      "river": {
        "hex": "#4A6670",
        "variable": "--river",
        "usage": "Deep river blue-grey — links, secondary icons, info states"
      }
    },
    "typography_tones": {
      "text_dark": {
        "hex": "#1A1410",
        "variable": "--text-dark",
        "usage": "All headlines and primary text"
      },
      "text_mid": {
        "hex": "#5C4F3A",
        "variable": "--text-mid",
        "usage": "Body text, descriptions, paragraph content"
      },
      "text_light": {
        "hex": "#9E8E78",
        "variable": "--text-light",
        "usage": "Labels, captions, eyebrow text, meta information"
      }
    },
    "rules": [
      "Never use pure black (#000000) — always use --deep or --text-dark",
      "Never use cool grays — all neutrals must have warm undertones",
      "Never use purple, blue-purple, or cool-toned gradients",
      "Gold is reserved for accents only — never flood large surfaces with gold",
      "Cream is the default page background — not white",
      "Text on dark backgrounds uses --gold-light or --white, never pure gray",
      "All color combinations must pass WCAG AA contrast minimum"
    ],
    "forbidden": ["#8B5CF6", "#6366F1", "#3B82F6", "#000000", "#F9FAFB", "#D1D5DB"]
  },

  "typography": {
    "description": "Two-font system — editorial serif for display, clean humanist sans for body",
    "display": {
      "family": "Cormorant Garamond",
      "source": "Google Fonts",
      "import": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap",
      "weights": {
        "400": "Regular — section headings",
        "400i": "Italic — poetic subheadings, pull quotes",
        "600": "SemiBold — hero headlines",
        "700": "Bold — reserved for hero only"
      },
      "usage": "All H1–H3 headings, hero text, package names, villa names, pull quotes",
      "character": "Timeless, elegant, high-end editorial"
    },
    "body": {
      "family": "Jost",
      "source": "Google Fonts",
      "import": "https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&display=swap",
      "weights": {
        "300": "Light — large intro paragraphs",
        "400": "Regular — all body text",
        "500": "Medium — labels, buttons, navigation, eyebrow text"
      },
      "usage": "Body text, navigation, buttons, labels, captions, form elements",
      "character": "Geometric, clean, modern — complements the serif perfectly"
    },
    "scale": {
      "hero_headline": {
        "size": "clamp(52px, 8vw, 96px)",
        "font": "Cormorant Garamond",
        "weight": 600,
        "line_height": 1.05,
        "letter_spacing": "-0.02em",
        "color": "--white (on dark) / --text-dark (on light)"
      },
      "h1": {
        "size": "clamp(40px, 5vw, 64px)",
        "font": "Cormorant Garamond",
        "weight": 600,
        "line_height": 1.1,
        "letter_spacing": "-0.015em"
      },
      "h2": {
        "size": "clamp(28px, 3.5vw, 44px)",
        "font": "Cormorant Garamond",
        "weight": 600,
        "line_height": 1.15
      },
      "h3": {
        "size": "clamp(20px, 2.5vw, 28px)",
        "font": "Cormorant Garamond",
        "weight": 400,
        "line_height": 1.25
      },
      "eyebrow": {
        "size": "11px",
        "font": "Jost",
        "weight": 500,
        "letter_spacing": "0.2em",
        "text_transform": "uppercase",
        "color": "--gold",
        "usage": "Section labels above headlines — e.g. OUR PHILOSOPHY, BENTOTA · SRI LANKA"
      },
      "body_large": {
        "size": "18px",
        "font": "Jost",
        "weight": 300,
        "line_height": 1.75,
        "color": "--text-mid"
      },
      "body": {
        "size": "16px",
        "font": "Jost",
        "weight": 400,
        "line_height": 1.7,
        "color": "--text-mid"
      },
      "caption": {
        "size": "13px",
        "font": "Jost",
        "weight": 400,
        "color": "--text-light"
      },
      "button": {
        "size": "13px",
        "font": "Jost",
        "weight": 500,
        "letter_spacing": "0.1em",
        "text_transform": "uppercase"
      }
    },
    "rules": [
      "Never use Arial, Inter, Roboto, or system fonts",
      "Headlines always in Cormorant Garamond — never Jost",
      "Body text always in Jost — never Cormorant Garamond",
      "Eyebrow labels always uppercase, letterspaced, gold colored",
      "Never use font-weight 700 except on hero headlines",
      "Italic Cormorant used for pull quotes and poetic emphasis only",
      "Sentence case for all body copy — Title Case only for proper names"
    ]
  },

  "spacing": {
    "description": "Generous whitespace — luxury breathes. Never cramped.",
    "base_unit": "8px",
    "scale": {
      "xs": "8px",
      "sm": "16px",
      "md": "24px",
      "lg": "40px",
      "xl": "64px",
      "2xl": "96px",
      "3xl": "128px",
      "4xl": "192px"
    },
    "section_padding": {
      "desktop": "128px 0",
      "tablet": "96px 0",
      "mobile": "64px 0"
    },
    "container": {
      "max_width": "1280px",
      "padding": "0 40px",
      "padding_mobile": "0 20px"
    },
    "rules": [
      "Sections breathe — minimum 96px vertical padding on desktop",
      "Never stack two dark sections back to back without a cream break",
      "Card padding minimum 32px",
      "Between eyebrow and headline: 12px",
      "Between headline and body: 20px",
      "Between body and CTA: 32px"
    ]
  },

  "layout": {
    "grid": {
      "columns": 12,
      "gutter": "32px",
      "breakpoints": {
        "mobile": "< 640px",
        "tablet": "640px – 1024px",
        "desktop": "> 1024px"
      }
    },
    "patterns": {
      "hero": "Full-bleed image/video · dark overlay 45–55% · centered or left-aligned text",
      "two_col": "Alternating — text left/image right, then image left/text right",
      "cards": "3-column grid on desktop, 2 on tablet, 1 on mobile",
      "feature": "Asymmetric — 60% content / 40% visual or 40% / 60%"
    },
    "rules": [
      "Asymmetry preferred over perfect symmetry — luxury is never perfectly centered",
      "Images always bleed to edge — never float with margins",
      "Text blocks max-width 640px for readability",
      "Overlap elements (text over image) for editorial feel",
      "Diagonal section dividers or angled clips for visual interest",
      "Never center-align long body paragraphs — left-align always"
    ]
  },

  "components": {
    "buttons": {
      "primary": {
        "background": "--gold",
        "color": "--deep",
        "padding": "16px 40px",
        "font": "Jost 500, 13px, uppercase, 0.1em letterspaced",
        "border_radius": "2px",
        "border": "none",
        "hover": {
          "background": "#B8955A",
          "transform": "translateY(-1px)"
        },
        "usage": "Main booking CTA — Reserve Your Retreat, Book Now"
      },
      "secondary": {
        "background": "transparent",
        "color": "--white",
        "padding": "15px 40px",
        "border": "1px solid rgba(255,255,255,0.5)",
        "border_radius": "2px",
        "hover": {
          "border_color": "--gold",
          "color": "--gold"
        },
        "usage": "Ghost button on dark backgrounds — Explore Treatments, Learn More"
      },
      "text_link": {
        "color": "--gold",
        "font": "Jost 500, 13px, uppercase, 0.1em letterspaced",
        "decoration": "none",
        "after": "→ (arrow, same color, margin-left 8px)",
        "hover": {
          "gap": "arrow moves 4px right on hover"
        },
        "usage": "In-page navigation — View All Packages →"
      },
      "rules": [
        "Border-radius maximum 4px — never pill-shaped buttons",
        "Primary button always gold — never any other color",
        "Never use rounded corners above 4px on buttons",
        "Button text always uppercase, always letterspaced",
        "Minimum touch target 48px height on mobile"
      ]
    },
    "cards": {
      "package_card": {
        "background": "--white",
        "border_radius": "4px",
        "overflow": "hidden",
        "border": "none",
        "shadow": "0 2px 32px rgba(26,20,16,0.08)",
